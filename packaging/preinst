#!/bin/sh
set -e

if [ "${DPKG_MAINTSCRIPT_PACKAGE:-}" = syslinuxos-ring-conky ] &&
   [ "$(dpkg-query -W -f='${Status}' syslinuxos-conky-ring 2>/dev/null || true)" = 'install ok installed' ]; then
    exit 0
fi

case "$1" in
    install|upgrade)
        if [ ! -e /var/lib/syslinuxos-conky-ring/legacy-settings.lua ]; then
            if [ -f /usr/share/conky/syslinuxos-ring/settings.lua ]; then
                source=/usr/share/conky/syslinuxos-ring/settings.lua
            elif [ -f /opt/Sys-ring-conky/settings.lua ]; then
                source=/opt/Sys-ring-conky/settings.lua
            else
                source=
            fi
            if [ -n "$source" ]; then
                install -d -m 700 /var/lib/syslinuxos-conky-ring
                install -m 600 "$source" /var/lib/syslinuxos-conky-ring/legacy-settings.lua
            fi
        fi
        ;;
esac

exit 0
